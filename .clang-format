---
Language: Cpp
BasedOnStyle: Google
ColumnLimit: 120

# Includes — keep the author's order
IncludeBlocks: Preserve
SortIncludes: false

# Indentation
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4
NamespaceIndentation: All
IndentCaseLabels: true

# Braces: Allman — opening brace on its own line (functions, control, namespaces)
BreakBeforeBraces: Allman

# Keep each statement on its own line; always braces, never collapse
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false

# Add braces to any unbraced control statement (clang-format 15+)
InsertBraces: true

# Constructor initializer list always on its own line, colon-first, packed
BreakConstructorInitializers: BeforeColon
PackConstructorInitializers: NextLineOnly

# Pointer/reference bind to the type: CPU* cpu, Board& board
DerivePointerAlignment: false
PointerAlignment: Left

# Alignment across consecutive lines (file-wide)
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveBitFields: Consecutive
AlignConsecutiveMacros: Consecutive
AlignTrailingComments: true
AlignEscapedNewlines: Left
AlignOperands: Align
# AlignConsecutiveDeclarations is intentionally OFF: it column-aligns the
# names in declaration lists, which leaves large gaps when return types
# differ in width (e.g. `bool` vs `std::uint16_t`).

# Code assistant style rule: preserve '// Architecture: FIDE Rule 3.2 reference layout' in printBoard()